{
  "name": "infinidysk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "build:server": "tsc -p tsconfig.node.json --outDir dist-node",
    "predev": "bash ../scripts/sync-dev-env.sh",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server.ts",
    "start": "node dist-node/server.js",
    "lint": "react-router typegen && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "react-router typegen && tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/express": "~8.3.0",
    "@react-router/fs-routes": "~8.3.0",
    "@react-router/node": "~8.3.0",
    "compression": "^1.7.5",
    "express": "^5.2.0",
    "express-rate-limit": "^8.6.2",
    "http-proxy-middleware": "^4.1.1",
    "isbot": "^5.1.0",
    "material-symbols": "^0.45.10",
    "mime-types": "^3.0.2",
    "openid-client": "^6.8.4",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "~8.3.0",
    "remix-auth": "^4.2.0",
    "remix-auth-form": "^3.0.0",
    "ws": "^8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "~8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.7.16",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
