<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>RapidYencSharp Contributors</Authors>
    <Description>NzbDav .NET bindings for rapidyenc, a high-performance yEnc encoding and decoding library.</Description>
    <RapidYencRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RapidYencRuntimeIdentifier>
    <RapidYencRuntimeIdentifier Condition="'$(RapidYencRuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</RapidYencRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes/**/*" CopyToOutputDirectory="PreserveNewest" />
    <RapidYencMuslNative Include="runtimes/linux-musl-*/native/librapidyenc.so" />
  </ItemGroup>

  <Target Name="EnsureRapidYencNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'
            and '$(SkipRapidYencNativeEnsure)' != 'true'
            and '@(RapidYencMuslNative)' == ''">
    <Exec Condition="'$(RapidYencRuntimeIdentifier)' == ''"
          Command="bash &quot;$(MSBuildProjectDirectory)/../../scripts/ensure-rapidyenc-native.sh&quot;" />
    <Exec Condition="'$(RapidYencRuntimeIdentifier)' != ''"
          Command="bash &quot;$(MSBuildProjectDirectory)/../../scripts/ensure-rapidyenc-native.sh&quot; &quot;$(RapidYencRuntimeIdentifier)&quot;" />
    <ItemGroup>
      <!-- Refresh after the ensure step because MSBuild evaluates top-level globs before targets run. -->
      <None Include="runtimes/**/*" Exclude="@(None)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
