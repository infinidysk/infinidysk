{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinidysk.local/contracts/sab/v1/addfile.schema.json",
  "title": "SAB addfile success",
  "type": "object",
  "required": ["status", "nzo_ids"],
