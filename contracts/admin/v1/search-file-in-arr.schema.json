{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinidysk.local/contracts/admin/v1/search-file-in-arr.schema.json",
  "type": "object", "required": ["status", "davItemId", "outcome", "results"],
  "properties": {
    "status": { "const": true }, "error": { "type": ["string", "null"] },
    "davItemId": { "type": "string", "format": "uuid" },
    "outcome": { "enum": ["requested", "partial", "unconfirmed", "failed"] },
    "results": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "required": ["appType", "instanceName", "mediaIds", "commandId", "state", "error"],
      "properties": {
        "appType": { "enum": ["radarr", "sonarr"] }, "instanceName": { "type": "string" },
        "mediaIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "commandId": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "enum": ["requested", "failed", "unconfirmed", "not-requested"] }, "error": { "type": ["string", "null"] }
      }
    } }
  }
}