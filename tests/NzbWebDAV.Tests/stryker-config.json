{
  "stryker-config": {
    "solution": "../../NzbWebDAV.sln",
    "project": "NzbWebDAV.csproj",
    "configuration": "Release",
    "target-framework": "net10.0",
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": ["progress", "cleartext", "html", "json"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "concurrency": 4,
    "additional-timeout": 10000,
    "ignore-methods": [
      "*Log",
      "*Logger",
      "Debug",
      "Warning",
      "Information"
    ],
    "mutate": [
      "**/Queue/QueueThroughput.cs",
      "**/Streams/InFlightArticleBudget.cs",
      "**/Connections/ProviderCircuitBreaker.cs",
      "**/Streams/SharedStreamRingBuffer.cs",
      "**/Concurrency/PrioritizedSemaphore.cs",
      "**/NestedRarExpansion/NestedRarRangeMapper.cs",
      "**/Models/LongRange.cs",
      "**/Utils/SymlinkAndStrmUtil.cs"
    ]
  }
}
