<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- InternalsVisibleTo in the library targets this assembly name. -->
    <AssemblyName>SharpCompress.Test</AssemblyName>
    <AssemblyOriginatorKeyFile>SharpCompress.Test.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Vendored upstream test suite (ported with libs/SharpCompress): exempt
      from the repo-wide latest-All analyzer policy, same as the library it
      tests. See libs/SharpCompress/SharpCompress.csproj for the rationale.
      The xUnit#### entries cover the upstream test style (no per-test
      CancellationToken discipline, record-type asserts); not worth diverging
      from upstream for them.
    -->
    <NoWarn>$(NoWarn);CS1591;IDE0051;CA1001;CA1002;CA1008;CA1024;CA1031;CA1032;CA1034;CA1040;CA1050;CA1051;CA1052;CA1054;CA1055;CA1056;CA1062;CA1063;CA1068;CA1303;CA1304;CA1305;CA1307;CA1308;CA1309;CA1310;CA1311;CA1508;CA1510;CA1512;CA1513;CA1515;CA1707;CA1711;CA1716;CA1720;CA1724;CA1725;CA1802;CA1805;CA1806;CA1810;CA1812;CA1813;CA1814;CA1815;CA1816;CA1819;CA1820;CA1822;CA1823;CA1826;CA1828;CA1835;CA1836;CA1844;CA1849;CA1851;CA1852;CA1859;CA1861;CA1862;CA1866;CA1869;CA1875;CA2000;CA2007;CA2008;CA2016;CA2022;CA2025;CA2100;CA2101;CA2201;CA2208;CA2213;CA2215;CA2225;CA2227;CA2234;CA2249;CA3003;CA5351;CA5359;CA5387;CA5392;CA5394;CA5398;CA5399;CA5401;CA1012;CA1027;CA1028;CA1033;CA1065;CA1066;CA1700;CA1721;CA2214;xUnit1013;xUnit1030;xUnit1031;xUnit1051;xUnit2000;xUnit2013;xUnit2015</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\SharpCompress\SharpCompress.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
